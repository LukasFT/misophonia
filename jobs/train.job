#!/bin/bash
#SBATCH --job-name=train_anc
#SBATCH --output=out/train_anc_%j.out
#SBATCH --cpus-per-task=2
#SBATCH --gres=gpu:1
#SBATCH --exclude=desktop[1-9],cn16,cn17
#SBATCH --time=24:00:00
#SBATCH --partition=scavenge

curl -LsSf https://astral.sh/uv/install.sh | sh
uv python install
uv sync --frozen --no-install-project

uv run -m python misophonia_dataset.main --help