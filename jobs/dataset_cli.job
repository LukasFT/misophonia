#!/bin/bash
#SBATCH --job-name=dataset_cli
#SBATCH --output=out/dataset_cli_%j.out
#SBATCH --cpus-per-task=8
##SBATCH --gres=gpu:1
##SBATCH --exclude=desktop[1-9],cn16,cn17
#SBATCH --time=24:00:00
#SBATCH --partition=scavenge

bash jobs/setup.sh

echo "*** Running: uv run -m misophonia_dataset.main $*"
uv run -m misophonia_dataset.main "$@"
echo "*** Finished ***"
